{
  "name": "rewindjs",
  "version": "0.1.0-alpha.0",
  "description": "Record and deterministically replay AI agent runs. Debug the failure at step 31 without paying for steps 1-30 again.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "replay",
    "record",
    "testing",
    "fixtures",
    "debugging",
    "anthropic",
    "openai",
    "mcp"
  ],
  "license": "MIT",
  "author": "Shamaz saeed",
  "type": "module",
  "sideEffects": true,
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.41.9"
  }
}
